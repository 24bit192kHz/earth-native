#!/usr/bin/env python3
"""Build a compact, offline HTML review from archived native A/B runs.
Usage: tools/report-ab ARTIFACT_ROOT OUTPUT.html
Requires Pillow. The HTML embeds preview images, not the full raw captures.
"""
import argparse
import base64
import io
import json
from pathlib import Path

from PIL import Image

COMPARISONS = [
    ("final", "Retained changes · NASA clouds", "baseline", "final", "Kept: same visible detail; less VRAM and Earth-pass work.", True),
    ("noaa", "Retained changes · NOAA clouds", "noaa/baseline", "noaa/final", "Kept: 81 MiB less VRAM; appearance preserved. Speed is uncertain because GPU clocks changed.", False),
    ("cache", "Cache reduction only", "baseline", "cache24", "Kept: 48/40 → 24/24 MiB budgets; 81 MiB less process VRAM. No visible detail loss in tested views.", True),
    ("air", "Atmosphere sampling only", "baseline", "air12", "Kept: 16 → 12 steps on steep ground views; grazing and limb integration preserved.", True),
    ("relief", "Rejected · stronger cloud relief", "baseline", "relief25", "Discarded: 1.5 → 2.5 km relief showed no convincing visual benefit.", True),
    ("highlight", "Rejected · brighter highlights", "baseline", "highlight", "Discarded: highlight knee 0.5 → 1.0 made sunrise harsher.", True),
    ("averaging", "Rejected · earlier cloud averaging", "noaa/baseline", "noaa/footprint", "Discarded: averaging starts at 0.75–4 km instead of 1.5–8 km; no convincing benefit. NOAA timings are not comparable.", False),
    ("moon", "Rejected · daylight lunar shortcut", "final", "efficient", "Discarded: the earlier bundle skips some daylight lunar shading. No convincing extra speed gain; this was not a separate isolated timing test.", False),
    ("diagnostic", "Diagnostic · clouds removed", "baseline", "no-clouds", "Diagnostic only: removing clouds showed the blocky patches came from cloud rendering. This is not an improvement candidate.", False),
]


def build(root):
    images, comparisons = {}, []

    def embed(path):
        key = str(path.relative_to(root))
        if key not in images:
            with Image.open(path) as image:
                image = image.convert("RGB")
                image.thumbnail((1600, 1200), Image.Resampling.LANCZOS)
                buf = io.BytesIO()
                image.save(buf, format="JPEG", quality=88, optimize=True)
                images[key] = "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()
        return key

    for key, title, before, after, verdict, timing in COMPARISONS:
        a = json.loads((root / before / "report.json").read_text())
        b = json.loads((root / after / "report.json").read_text())
        assert a["weather"] == b["weather"], title
        scenes = []
        for name in a["scenes"]:
            if name not in b["scenes"]:
                continue
            sa, sb = a["scenes"][name], b["scenes"][name]
            assert sa["unix"] == sb["unix"] and sa["camera"] == sb["camera"], title
            outputs = {}
            for output in ("DP-2", "DP-1"):
                pa, pb = root / before / f"{name}-{output}.jpg", root / after / f"{name}-{output}.jpg"
                if not pa.exists() or not pb.exists():
                    continue
                ma = json.loads(pa.with_suffix(".json").read_text())["frame"]
                mb = json.loads(pb.with_suffix(".json").read_text())["frame"]
                assert ma == mb, f"Frame metadata differs: {title}/{name}/{output}"
                outputs[output] = [embed(pa), embed(pb)]
            assert outputs, f"No captures: {title}/{name}"
            scenes.append(dict(name=name, outputs=outputs, earth=[sa["earth_ms"], sb["earth_ms"]],
                               vram=[sa["vram_mib"], sb["vram_mib"]]))
        comparisons.append(dict(key=key, title=title, before=before, after=after,
                                verdict=verdict, timing=timing, scenes=scenes))
    return dict(images=images, comparisons=comparisons)


