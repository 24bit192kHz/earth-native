def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("artifacts", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    data = build(args.artifacts.resolve())
    rows = []
    for s in data["comparisons"][0]["scenes"]:
        before, after = s["earth"]
        rows.append(f'<tr><td>{s["name"].capitalize()}</td><td>{before:.2f} → {after:.2f}</td><td>{(before-after)/before*100:.1f}%</td></tr>')
    html = TEMPLATE.replace("__TIMINGS__", "".join(rows)).replace("__DATA__", json.dumps(data, separators=(",", ":")).replace("<", "\\u003c"))
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(html)
    print(f"{args.output}: {len(data['comparisons'])} comparisons, {len(data['images'])} embedded previews, {args.output.stat().st_size / 1024**2:.2f} MiB")


if __name__ == "__main__":
    main()
